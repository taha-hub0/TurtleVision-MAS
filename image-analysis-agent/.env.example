# Goruntu analiz ajani. Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# .env asla depoya girmemeli (bkz. .gitignore).

PORT=5000

# ArcFace checkpoint yolu. Dosyayi indirmek icin:
#     python reid/fetch_model.py
# Checkpoint depoda tutulmuyor; GitHub Release'inden gelir.
MODEL_PATH=./src/models/weights/arcface_best.pt
CONFIDENCE_THRESHOLD=0.85

# Yatay cevirme test-zamani artirimi (flip-TTA). Kapatirsaniz galeriyi de
# ayni ayarla yeniden gomun, yoksa /health 503 doner.
# TURTLE_FLIP_TTA=1

# Veritabani - GERCEK PAROLAYI BURAYA YAZMAYIN
DB_HOST=localhost
DB_PORT=3306
DB_USER=degistirin
DB_PASSWORD=degistirin
DB_NAME=turtle_id_db

LOG_LEVEL=INFO
