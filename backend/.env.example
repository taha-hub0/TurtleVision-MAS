# Koordinator ajani. Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# .env asla depoya girmemeli (bkz. .gitignore).

PORT=3000
NODE_ENV=development

# Ajan uc noktalari
IMAGE_AGENT_URL=http://localhost:5000
IMAGE_AGENT_TIMEOUT=180000
DB_AGENT_URL=http://localhost:5001
DB_AGENT_TIMEOUT=30000

# Veritabani - GERCEK PAROLAYI BURAYA YAZMAYIN
DB_HOST=localhost
DB_PORT=3306
DB_USER=degistirin
DB_PASSWORD=degistirin
DB_NAME=turtle_id_db

# Yukleme
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

LOG_LEVEL=info
LOG_FILE=./logs/app.log
